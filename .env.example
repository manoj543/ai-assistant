# This file is documentation; the app does not load .env automatically.
# PowerShell: $env:AI_PROVIDER="groq" (repeat for each setting)
AI_PROVIDER=groq
GROQ_API_KEY=replace-in-server-environment-only
GROQ_MODEL=openai/gpt-oss-20b
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io
REQUESTS_PER_MINUTE=10
MAX_CONCURRENT_REQUESTS=2
# Local Ollama: AI_PROVIDER=ollama, no Groq key needed
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
